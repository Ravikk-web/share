graph TD
    classDef default fill:#f8f9fb,stroke:#e4e7ec,stroke-width:2px;
    classDef step fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#101828;
    classDef decision fill:#fff8e1,stroke:#d97706,stroke-width:2px,color:#101828,shape:diamond;
    classDef pass fill:#e6f4ea,stroke:#16a34a,stroke-width:2px,color:#101828;
    classDef fail fill:#fdecea,stroke:#dc2626,stroke-width:2px,color:#101828;

    A([Start Hop]) --> B[Set Channel<br>oc adm upgrade channel stable-x.y]:::step
    B --> C[Verify Edge Available]:::step
    
    C --> D{Is valid edge?}:::decision
    D -- No --> E[Fail & Logout]:::fail
    
    D -- Yes --> F{Requires<br>Admin-Ack?}:::decision
    F -- Yes --> G[Apply Admin-Ack ConfigMap]:::step
    G --> H
    F -- No --> H[Trigger Upgrade<br>oc adm upgrade --to]:::step
    
    H --> I[Phase 04: Live Monitoring]:::step
    I --> J[Settle Gate]:::step
    
    J --> K{Settle Gate<br>Passed?}:::decision
    K -- Yes --> L([Next Hop / Finish]):::pass
    K -- No --> E
