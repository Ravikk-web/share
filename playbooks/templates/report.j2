{#
==============================================================================
report.j2 - the run's single HTML report (written by steps/common/write_report.yml)
==============================================================================
One section per phase that ran, in run order. Only renders facts set during the run;
nothing is decided here. Statuses: PASS, WARN, FAIL, AUTO-FIXED, FIX-FAILED, SKIPPED.
Standalone page: max-width 1080px, no external resources, details expand when printed.
==============================================================================
#}
{%- macro pill(status) -%}
{%- set s = status | default('INFO') | string | upper -%}
{%- set k = 'fixfailed' if s == 'FIX-FAILED' else ('fail' if s in ['FAIL', 'FAILED'] else ('autofix' if s == 'AUTO-FIXED' else ('warn' if s == 'WARN' else ('pass' if (s in ['PASS', 'ALREADY DONE'] or s.startswith('COMPLETE')) else 'info')))) -%}
<span class="pill {{ k }}">{{ s | e }}</span>
{%- endmacro -%}
{%- macro check_table(rows) -%}
<table>
  <tr><th>#</th><th>Check</th><th>Gate</th><th>Result</th><th>Observed</th></tr>
  {%- for c in rows %}
  <tr><td>{{ '%02d' | format(c.num | int) }}</td><td>{{ c.name | e }}</td><td>{{ c.gate | e }}</td><td>{{ pill(c.status) }}</td><td>{{ c.observed | e }}</td></tr>
  {%- endfor %}
</table>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ cluster_name | e }} {{ run_mode | e }} report {{ run_timestamp | e }}</title>
<style>
  body { margin: 0; padding: 24px; background: {{ color_page_bg }}; color: {{ color_heading }};
         font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  .page { max-width: {{ report_max_width }}; margin: 0 auto; background: {{ color_surface }}; border: 1px solid {{ color_border }}; border-radius: 8px; }
  header { padding: 24px 32px; border-bottom: 1px solid {{ color_border }}; }
  h1 { margin: 0 0 6px 0; font-size: 22px; }
  h2 { margin: 0 0 12px 0; font-size: 16px; }
  section { padding: 20px 32px; border-bottom: 1px solid {{ color_border }}; }
  .meta { color: #667085; font-size: 13px; }
  .meta b { color: #344054; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 8px; }
  th { text-align: left; background: #f9fafb; color: #475467; }
  th, td { padding: 6px 10px; border-bottom: 1px solid {{ color_border }}; vertical-align: top; }
  code, .mono { font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace; font-size: 12px; }
  .pill { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 12px; font-weight: 700; white-space: nowrap; }
  .pass { color: {{ color_pass }}; background: {{ bg_pass }}; }
  .warn { color: {{ color_warn }}; background: {{ bg_warn }}; }
  .fail { color: {{ color_fail }}; background: {{ bg_fail }}; }
  .autofix { color: {{ color_autofix }}; background: {{ bg_autofix }}; }
  .fixfailed { color: {{ color_fixfailed }}; background: {{ bg_fixfailed }}; }
  .info { color: {{ color_info }}; background: {{ bg_info }}; }
  .box { padding: 12px 16px; border-radius: 6px; margin-bottom: 12px; }
  pre { white-space: pre-wrap; word-break: break-all; background: #0f172a; color: #f8fafc; padding: 12px; border-radius: 4px; }
  footer { padding: 16px 32px; color: #667085; font-size: 12px; }
  @media print { body { background: #fff; padding: 0; } details { display: block; } details > * { display: block; } }
</style>
</head>
<body>
<div class="page">

<header>
  <h1>{{ cluster_name | e }} &bull; {{ run_mode | e }} {{ pill(run_verdict) }}</h1>
  <div class="meta">
    <b>Run</b> {{ run_timestamp | e }} &bull; <b>Duration</b> {{ run_duration | default('') | e }} &bull;
    <b>Path</b> {{ (upgrade_path | default([]) | join(' -> ')) or 'current version' }} &bull;
    <b>Version</b> {{ run_start_version | default('?') | e }} -> {{ run_final_version | default('?') | e }}
    {%- if dry_run | bool %} &bull; <b>Dry run: nothing on the cluster was changed</b>{% endif %}
  </div>
  <p>{{ run_summary_text | default('') | e }}</p>
</header>

{% if run_failed | bool %}
<section>
  <h2>Why the run stopped</h2>
  <div class="box fail"><b>{{ failure_reason | default('') | e }}</b> (exit code {{ failure_exit_code | default('') }})</div>
  <pre>{{ resolved_error | default('') | string | truncate(4000) | e }}</pre>
</section>
{% endif %}

<section>
  <h2>Phases</h2>
  <table>
    <tr><th>Phase</th><th>Name</th><th>Result</th><th>Detail</th></tr>
    {%- for p in run_phase_results %}
    <tr><td>{{ p.phase | e }}</td><td>{{ p.name | e }}</td><td>{{ pill(p.status) }}</td><td>{{ p.detail | e }}</td></tr>
    {%- endfor %}
  </table>
</section>

{% if path_validation is defined %}
<section>
  <h2>01 &bull; Upgrade path</h2>
  <p class="meta">Baseline snapshot: <code>{{ baseline_snapshot_file_path | default('') | basename | e }}</code></p>
  <table>
    <tr><th>Edge</th><th>Channel</th><th>Result</th><th>Detail</th></tr>
    {%- for r in path_validation %}
    <tr><td class="mono">{{ ((r['from'] ~ ' -> ') if (r['from'] | length > 0) else '') ~ r.to }}</td><td>{{ r.channel | e }}</td><td>{{ pill(r.status) }}</td>
        <td>{{ r.detail | e }}{% if r.risks | default([]) | length > 0 %}<br>Risks: {% for k in r.risks %}<a href="{{ k.url | e }}">{{ k.name | e }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</td></tr>
    {%- endfor %}
  </table>
</section>
{% endif %}

{% if preval_checks | length > 0 %}
<section>
  <h2>02 &bull; Prechecks{{ ' (run again after the Phase 03 changes)' if (preval_rechecked | default(false) | bool) else '' }}</h2>
  {{ check_table(preval_checks) }}
  {% if installed_operators | length > 0 %}
  <details open><summary><b>Installed operators ({{ installed_operators | length }})</b></summary>
  <table>
    <tr><th>Operator</th><th>Namespace</th><th>Version</th><th>Channel</th><th>CSV phase</th><th>Blocks upgrade</th><th>Result</th><th>Notes</th></tr>
    {%- for o in installed_operators %}
    <tr><td>{{ o.package | e }}</td><td>{{ o.namespace | e }}</td><td class="mono">{{ (o.version or o.csv) | e }}</td><td>{{ o.channel | e }}</td>
        <td>{{ o.phase | e }}</td><td>{{ ('Yes (max ' ~ o.max_ocp ~ ')') if (o.blocks_upgrade | bool) else 'No' }}</td>
        <td>{{ pill(o.status | default('PASS')) }}</td><td>{{ o.issues | default([]) | join('; ') | e }}</td></tr>
    {%- endfor %}
  </table></details>
  {% endif %}
</section>
{% endif %}

{%- set acks_03 = [] -%}
{%- set acks_04 = [] -%}
{%- for a in admin_acks_applied | default([]) -%}
{%- if (a.phase | default('')) == '03' -%}{%- set _ = acks_03.append(a) -%}{%- else -%}{%- set _ = acks_04.append(a) -%}{%- endif -%}
{%- endfor %}
{% if preimpl_tasks | default([]) | length > 0 %}
<section>
  <h2>03 &bull; Pre-upgrade implementation{{ ' (plan only)' if (dry_run | bool) else '' }}</h2>
  <p class="meta">Each task: check, change if needed, watch any node rollout it started, verify.</p>
  <table>
    <tr><th>#</th><th>Task</th><th>Result</th><th>What was found and done</th></tr>
    {%- for t in preimpl_tasks %}
    <tr><td>{{ t.num | e }}</td><td>{{ t.name | e }}</td><td>{{ pill(t.status) }}</td><td>{{ t.observed | e }}</td></tr>
    {%- endfor %}
  </table>
  {% if preval_autofix_items | length > 0 %}
  <div class="box autofix"><b>Changes made</b><ul>
    {%- for f in preval_autofix_items %}<li><b>{{ f.name | e }}</b>: {{ f.action | e }} (<a href="{{ f.reference | e }}">docs</a>)</li>{% endfor %}
  </ul></div>
  {% endif %}
  {% if acks_03 | length > 0 %}
  <div class="box autofix"><b>Admin-acks applied</b><ul>
    {%- for a in acks_03 %}<li><code>{{ a.key | e }}</code> before {{ a.hop | e }}</li>{% endfor %}
  </ul></div>
  {% endif %}
</section>
{% endif %}

{% if (hop_results | length > 0) or (acks_04 | length > 0) %}
<section>
  <h2>04 &bull; Upgrade hops</h2>
  <table>
    <tr><th>Hop</th><th>Target</th><th>Result</th><th>Duration</th></tr>
    {%- for h in hop_results %}
    <tr><td>{{ h.hop_label | e }}</td><td class="mono">{{ h.target | e }}</td><td>{{ pill(h.status) }}</td><td>{{ h.duration | e }}</td></tr>
    {%- endfor %}
  </table>
  {% if acks_04 | length > 0 %}
  <div class="box autofix"><b>Admin-acks applied</b><ul>
    {%- for a in acks_04 %}<li><code>{{ a.key | e }}</code> before {{ a.hop | e }}</li>{% endfor %}
  </ul></div>
  {% endif %}
</section>
{% endif %}

{% if postval_checks | length > 0 %}
<section>
  <h2>06 &bull; Postchecks{{ ' (audit only)' if (dry_run | bool) else '' }}</h2>
  {{ check_table(postval_checks) }}
</section>
{% endif %}

{% if operator_checks | length > 0 %}
<section>
  <h2>07 &bull; Operators and developer console{{ ' (plan only)' if (dry_run | bool) else '' }}</h2>
  {{ check_table(operator_checks) }}
  {% if operators | length > 0 %}
  <details><summary><b>Subscriptions ({{ operators | length }})</b></summary>
  <table>
    <tr><th>Operator</th><th>Namespace</th><th>Installed CSV</th><th>Channel</th><th>Approval</th><th>Result</th><th>Detail</th></tr>
    {%- for o in operators %}
    <tr><td>{{ o.package | e }}</td><td>{{ o.namespace | e }}</td><td class="mono">{{ o.installed_csv | e }}</td><td>{{ o.target_channel | e }}</td>
        <td>{{ o.installplan_approval | e }}</td><td>{{ pill(o.status) }}</td><td>{{ o.details | e }}</td></tr>
    {%- endfor %}
  </table></details>
  {% endif %}
</section>
{% endif %}

<footer>
  Run log: <code>{{ log_file | e }}</code> &bull; Generated {{ lookup('pipe', 'date +%Y-%m-%dT%H:%M:%S%z') }} on {{ ansible_hostname | default('localhost') | e }}
  by the ARO Cluster Upgrade automation.
</footer>
</div>
</body>
</html>
