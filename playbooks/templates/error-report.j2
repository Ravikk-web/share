{#- Targets Ansible 2.7.17.
    MIGRATION 2.14: No changes required — Jinja2 template is compatible with both versions.
    
    error-report.j2 — Failure Alert Email Template (Concise & High-Impact)
    Presentation-only: Renders short, colour-coded HTML for failure alerts and RBAC errors.
    All status colours and gate verdicts are driven by passed-in variables.
-#}
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ report_title | default('ARO Cluster Upgrade') }} — Failure Alert</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f8f9fb; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px; line-height: 1.4; color: #344054; -webkit-font-smoothing: antialiased;">

  <!-- Outer Background Container -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8f9fb; padding: 16px 8px;">
    <tr>
      <td align="center">

        <!-- Main Card Container (max-width 580px) -->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 580px; margin: 0 auto; background-color: #ffffff; border: 1px solid #e4e7ec; border-radius: 8px; overflow: hidden; border-collapse: separate;">

          <!-- Header Band -->
          <tr>
            <td style="background-color: #ffffff; padding: 14px 18px; border-bottom: 2px solid #fdecea;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td valign="middle" style="text-align: left;">
                    <div style="font-size: 11px; font-weight: 700; color: #b42318; text-transform: uppercase; letter-spacing: 0.6px;">
                      {{ report_org | default('ARO Automation') }} &bull; Upgrade Alert
                    </div>
                    <div style="font-size: 17px; font-weight: 700; color: #101828; margin-top: 2px;">
                      Cluster: <span style="font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;">{{ cluster_name | default('N/A') }}</span>
                    </div>
                  </td>
                  <td valign="middle" align="right" style="text-align: right; width: 100px;">
                    <!-- Verdict Pill -->
                    <span style="display: inline-block; padding: 4px 10px; font-size: 12px; font-weight: 700; color: #b42318; background-color: #fdecea; border: 1px solid #ffa39e; border-radius: 12px; text-transform: uppercase;">
                      FAIL {{ (status_glyphs | default({})).fail | default('✖') }}
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Metadata Strip -->
          <tr>
            <td style="background-color: #f8f9fb; padding: 6px 18px; border-bottom: 1px solid #e4e7ec; font-size: 11px; color: #667085;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="text-align: left;">
                    <strong>Phase:</strong> <code style="font-family: 'SFMono-Regular', Consolas, monospace; font-size: 11px; color: #101828;">{{ phase_name | default(failed_phase | default('Upgrade Phase')) }}</code>
                  </td>
                  <td style="text-align: right;">
                    <strong>Time:</strong> {{ timestamp | default(run_id | default('N/A')) }}
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Body Content -->
          <tr>
            <td style="padding: 16px 18px;">

              {% if (is_rbac_error | default(false)) or ('forbidden' in (failure_reason | default('') | lower)) or ('cannot patch' in (failure_reason | default('') | lower)) or ('unauthorized' in (failure_reason | default('') | lower)) %}
              <!-- RBAC Permission Denial Banner -->
              <div style="background-color: #fdecea; border: 1px solid #ffa39e; border-left: 4px solid #b42318; border-radius: 4px; padding: 12px 14px; margin-bottom: 14px;">
                <div style="font-size: 13px; font-weight: 700; color: #b42318; margin-bottom: 4px;">
                  ⚠️ Service Account RBAC Permission Denied (Forbidden)
                </div>
                <div style="font-size: 12px; color: #344054; line-height: 1.4; margin-bottom: 8px;">
                  The authenticated service account does not have sufficient OpenShift cluster privileges to perform the requested upgrade operation.
                </div>
                <div style="font-size: 11px; font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace; color: #b42318; background-color: #ffffff; border: 1px solid #ffa39e; padding: 6px 8px; border-radius: 4px; word-break: break-all;">
                  {{ failure_reason | default(observed_value | default('Permission denied: cannot patch resource clusterversions at cluster scope')) }}
                </div>
                <div style="font-size: 11px; color: #667085; margin-top: 6px;">
                  <strong>Remediation:</strong> Grant <code style="font-family: 'SFMono-Regular', Consolas, monospace; color: #b42318;">cluster-admin</code> or dedicated upgrade ClusterRole permissions to the service account.
                </div>
              </div>
              {% else %}
              <!-- General Failure Summary Banner -->
              <div style="background-color: #fdecea; border: 1px solid #ffa39e; border-left: 4px solid #b42318; border-radius: 4px; padding: 10px 12px; margin-bottom: 14px;">
                <div style="font-size: 13px; font-weight: 700; color: #b42318; margin-bottom: 3px;">
                  {{ (status_glyphs | default({})).fail | default('✖') }} Upgrade Halted — HARD Gate Failure
                </div>
                <div style="font-size: 12px; color: #344054; line-height: 1.4;">
                  {{ failure_summary | default('A critical check failed during phase execution. Automated session teardown was initiated.') }}
                </div>
              </div>
              {% endif %}

              <!-- Concise Failure Details Card -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse; margin-bottom: 14px; border: 1px solid #e4e7ec; border-radius: 4px; font-size: 12px;">
                <tr>
                  <td style="padding: 7px 10px; background-color: #f8f9fb; border-bottom: 1px solid #e4e7ec; font-weight: 600; color: #344054; width: 110px;">
                    Failed Check:
                  </td>
                  <td style="padding: 7px 10px; background-color: #ffffff; border-bottom: 1px solid #e4e7ec; font-weight: 600; color: #101828;">
                    {{ failed_check_name | default(check_name | default(current_task_name | default('Upgrade Sequence'))) }}
                  </td>
                </tr>
                <tr>
                  <td style="padding: 7px 10px; background-color: #f8f9fb; border-bottom: 1px solid #e4e7ec; font-weight: 600; color: #344054;">
                    Observed:
                  </td>
                  <td style="padding: 7px 10px; background-color: #ffffff; border-bottom: 1px solid #e4e7ec; color: #344054;">
                    {{ observed_value | default(observed | default(failure_observed | default('Task non-zero exit'))) }}
                  </td>
                </tr>
                {% if not (is_rbac_error | default(false)) and (failure_reason is defined and failure_reason | length > 0) %}
                <tr>
                  <td style="padding: 7px 10px; background-color: #f8f9fb; border-bottom: 1px solid #e4e7ec; font-weight: 600; color: #344054; vertical-align: top;">
                    Error Details:
                  </td>
                  <td style="padding: 7px 10px; background-color: #ffffff; border-bottom: 1px solid #e4e7ec; font-family: 'SFMono-Regular', Consolas, monospace; font-size: 11px; color: #b42318; word-break: break-all;">
                    {{ failure_reason }}
                  </td>
                </tr>
                {% endif %}
                <tr>
                  <td style="padding: 7px 10px; background-color: #f8f9fb; font-weight: 600; color: #344054;">
                    Session Status:
                  </td>
                  <td style="padding: 7px 10px; background-color: #ffffff; color: #1a7f37; font-weight: 600;">
                    <span style="display: inline-block; padding: 1px 5px; font-size: 10px; font-weight: 700; color: #1a7f37; background-color: #e6f4ea; border-radius: 3px; margin-right: 4px;">
                      {{ (status_glyphs | default({})).pass | default('✔') }} LOGGED OUT
                    </span>
                    Kubeconfig invalidated safely
                  </td>
                </tr>
              </table>

              <!-- Action Strip -->
              <div style="background-color: #f8f9fb; border: 1px solid #e4e7ec; border-radius: 4px; padding: 8px 12px; font-size: 11px; color: #475467;">
                <strong>Next Step:</strong> Review full logs on jump server at <code style="font-family: 'SFMono-Regular', Consolas, monospace; color: #101828;">{{ log_path | default('logs/') }}</code>, resolve the error above, and re-run <code style="font-family: 'SFMono-Regular', Consolas, monospace; color: #101828;">00_Run.sh</code>.
              </div>

            </td>
          </tr>

          <!-- Footer Band -->
          <tr>
            <td style="background-color: #f8f9fb; padding: 10px 18px; border-top: 1px solid #e4e7ec; text-align: center; font-size: 11px; color: #667085;">
              {{ report_footer | default('Generated by ARO Cluster Upgrade Automation') }} &bull; Run ID: <code style="font-family: 'SFMono-Regular', Consolas, monospace;">{{ run_id | default('N/A') }}</code>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
