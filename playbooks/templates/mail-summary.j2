{#
==============================================================================
mail-summary.j2 - the one summary mail at the end of a successful run
==============================================================================
Reads: run_verdict, run_summary_text, run_phase_results, hop_results,
preval_autofix_items, admin_acks_applied, operator_summary_text,
developer_perspective_status. The full report is attached.
Max width 580px, inline CSS, no JavaScript, cluster text escaped.
==============================================================================
#}
{%- set v = run_verdict | default('PASS') -%}
{%- set fg = {'FAIL': color_fail, 'WARN': color_warn, 'AUTO-FIXED': color_autofix}[v] | default(color_pass) -%}
{%- set bg = {'FAIL': bg_fail, 'WARN': bg_warn, 'AUTO-FIXED': bg_autofix}[v] | default(bg_pass) -%}
{%- set td = 'padding: 6px 10px; border-bottom: 1px solid ' ~ color_border ~ ';' -%}
<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><title>{{ cluster_name | e }} {{ run_mode | e }}</title></head>
<body style="margin: 0; padding: 20px 0; background-color: {{ color_page_bg }}; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.5; color: {{ color_heading }};">
<table border="0" cellspacing="0" cellpadding="0" align="center" style="max-width: {{ email_max_width }}; width: 100%; background-color: {{ color_surface }}; border: 1px solid {{ color_border }}; border-top: 4px solid {{ fg }}; border-radius: 6px;">
  <tr><td style="padding: 24px; border-bottom: 1px solid {{ color_border }};">
    <span style="display: inline-block; padding: 4px 10px; font-size: 12px; font-weight: 700; border-radius: 12px; background-color: {{ bg }}; color: {{ fg }};">{{ v }}</span>
    <h1 style="margin: 12px 0 4px 0; font-size: 20px;">{{ cluster_name | e }} &bull; {{ run_mode | e }}</h1>
    <p style="margin: 0; font-size: 13px; color: #667085;">{{ run_summary_text | default('') | e }}</p>
  </td></tr>
  <tr><td style="padding: 20px 24px;">
    <p style="margin: 0 0 12px 0; font-size: 13px;">
      Run <b>{{ run_timestamp | e }}</b> &bull; {{ run_duration | default('') | e }} &bull;
      {{ run_start_version | default('?') | e }} &rarr; <b>{{ run_final_version | default('?') | e }}</b>
    </p>

    <table width="100%" style="border-collapse: collapse; font-size: 12px; margin-bottom: 16px; border: 1px solid {{ color_border }};">
      {%- for p in run_phase_results %}
      <tr><td style="{{ td }} font-weight: 600;">{{ p.phase | e }}</td>
          <td style="{{ td }}">{{ p.name | e }}<div style="color: #667085;">{{ p.detail | truncate(200) | e }}</div></td>
          <td style="{{ td }} text-align: right; font-weight: 700;">{{ p.status | e }}</td></tr>
      {%- endfor %}
    </table>

    {% if hop_results | length > 0 %}
    <table width="100%" style="border-collapse: collapse; font-size: 12px; margin-bottom: 16px; border: 1px solid {{ color_border }};">
      {%- for h in hop_results %}
      <tr><td style="{{ td }}">{{ h.label | e }} &rarr; {{ h.target | e }}</td><td style="{{ td }}">{{ h.duration | e }}</td>
          <td style="{{ td }} text-align: right; font-weight: 700;">{{ h.status | e }}</td></tr>
      {%- endfor %}
    </table>
    {% endif %}

    {% set changes = [] %}
    {% for f in preval_autofix_items %}{% set _ = changes.append(f.name ~ ': ' ~ f.action) %}{% endfor %}
    {% for a in admin_acks_applied %}{% set _ = changes.append('Admin-ack ' ~ a.key ~ ' before ' ~ a.hop) %}{% endfor %}
    {% if operator_summary_text is defined %}{% set _ = changes.append('Operators: ' ~ operator_summary_text) %}{% endif %}
    {% if developer_perspective_status is defined %}{% set _ = changes.append('Developer perspective: ' ~ developer_perspective_status) %}{% endif %}
    {% if changes | length > 0 %}
    <div style="font-size: 13px; font-weight: 700; color: #475467;">Changes and results</div>
    <ul style="margin: 4px 0 16px 0; padding-left: 18px; font-size: 13px;">
      {%- for c in changes %}<li>{{ c | e }}</li>{% endfor %}
    </ul>
    {% endif %}

    <p style="margin: 0; font-size: 12px; color: #667085;">The full report and the run logs are attached.</p>
  </td></tr>
  <tr><td style="padding: 16px 24px; background-color: #f9fafb; border-top: 1px solid {{ color_border }}; font-size: 12px; color: #667085;">
    Automated message from the ARO Cluster Upgrade automation on {{ ansible_hostname | default('localhost') | e }}. Do not reply.
  </td></tr>
</table>
</body>
</html>
