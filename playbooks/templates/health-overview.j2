<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ report_title | default('ARO Health Overview Report') }} &bull; {{ cluster_name | default('Cluster') }}</title>
  <style>
    :root {
      --color-pass: {{ color_pass | default('#1a7f37') }};
      --bg-pass: {{ bg_pass | default('#e6f4ea') }};
      --color-warn: {{ color_warn | default('#9a6700') }};
      --bg-warn: {{ bg_warn | default('#fff8e1') }};
      --color-fail: {{ color_fail | default('#b42318') }};
      --bg-fail: {{ bg_fail | default('#fdecea') }};
      --color-autofix: {{ color_autofix | default('#1d4ed8') }};
      --bg-autofix: {{ bg_autofix | default('#eff6ff') }};
      --color-fixfailed: {{ color_fixfailed | default('#c2410c') }};
      --bg-fixfailed: {{ bg_fixfailed | default('#ffedd5') }};
      --color-info: {{ color_info | default('#344054') }};
      --bg-info: {{ bg_info | default('#f2f4f7') }};
      --color-surface: {{ color_surface | default('#ffffff') }};
      --color-page-bg: {{ color_page_bg | default('#f8f9fb') }};
      --color-border: {{ color_border | default('#e4e7ec') }};
      --color-heading: {{ color_heading | default('#101828') }};
    }

    body {
      margin: 0;
      padding: 24px;
      background-color: var(--color-page-bg);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 14px;
      line-height: 1.5;
      color: var(--color-heading);
      -webkit-font-smoothing: antialiased;
    }

    .report-container {
      max-width: {{ report_max_width | default('1080px') }};
      margin: 0 auto;
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      box-shadow: 0 1px 3px rgba(16, 24, 40, 0.05);
      overflow: hidden;
    }

    .header-band {
      padding: 24px 32px;
      background-color: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 16px;
    }

    .header-info h1 {
      margin: 0 0 6px 0;
      font-size: 22px;
      font-weight: 700;
      color: var(--color-heading);
    }

    .header-meta {
      font-size: 13px;
      color: #667085;
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
    }

    .header-meta-item strong {
      color: #344054;
    }

    .verdict-badge {
      display: inline-flex;
      align-items: center;
      padding: 6px 14px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.5px;
      border-radius: 16px;
      text-transform: uppercase;
    }

    .verdict-pass {
      background-color: var(--bg-pass);
      color: var(--color-pass);
      border: 1px solid #b7e1cd;
    }
    .verdict-warn {
      background-color: var(--bg-warn);
      color: var(--color-warn);
      border: 1px solid #fedf89;
    }
    .verdict-fail {
      background-color: var(--bg-fail);
      color: var(--color-fail);
      border: 1px solid #fecdca;
    }
    .verdict-autofix {
      background-color: var(--bg-autofix);
      color: var(--color-autofix);
      border: 1px solid #bfdbfe;
    }
    .verdict-fixfailed {
      background-color: var(--bg-fixfailed);
      color: var(--color-fixfailed);
      border: 1px solid #fdba74;
    }

    .metrics-section {
      padding: 24px 32px;
      background-color: #fcfcfd;
      border-bottom: 1px solid var(--color-border);
    }

    .metric-tiles {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 16px;
    }

    .metric-tile {
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 6px;
      padding: 14px 18px;
      text-align: center;
    }

    .metric-tile .label {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #667085;
      margin-bottom: 4px;
    }

    .metric-tile .count {
      font-size: 24px;
      font-weight: 700;
      line-height: 1.2;
    }

    .content-body {
      padding: 24px 32px;
    }

    .section-title {
      font-size: 15px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #475467;
      margin: 24px 0 12px 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .section-title:first-child {
      margin-top: 0;
    }

    .callout-box {
      border-radius: 6px;
      padding: 16px 20px;
      margin-bottom: 24px;
      font-size: 13px;
      line-height: 1.5;
    }

    .callout-autofix {
      background-color: var(--bg-autofix);
      border: 1px solid #bfdbfe;
      color: #1e40af;
    }

    .status-table {
      width: 100%;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      border-collapse: collapse;
      font-size: 13px;
      margin-bottom: 24px;
      overflow: hidden;
    }

    .status-table th {
      background-color: #f9fafb;
      padding: 10px 14px;
      text-align: left;
      font-weight: 600;
      color: #344054;
      border-bottom: 1px solid var(--color-border);
    }

    .status-table td {
      padding: 10px 14px;
      border-bottom: 1px solid var(--color-border);
      vertical-align: middle;
    }

    .status-table tr:last-child td {
      border-bottom: none;
    }

    .row-pass { background-color: #ffffff; }
    .row-warn { background-color: #fffdf5; }
    .row-fail { background-color: #fffbfa; }
    .row-autofix { background-color: #f8fbff; }
    .row-fixfailed { background-color: #fffaf5; }

    .status-pill {
      display: inline-block;
      padding: 3px 8px;
      font-size: 11px;
      font-weight: 700;
      border-radius: 12px;
      white-space: nowrap;
    }

    .pill-pass {
      background-color: var(--bg-pass);
      color: var(--color-pass);
      border: 1px solid #b7e1cd;
    }

    .pill-warn {
      background-color: var(--bg-warn);
      color: var(--color-warn);
      border: 1px solid #fedf89;
    }

    .pill-fail {
      background-color: var(--bg-fail);
      color: var(--color-fail);
      border: 1px solid #fecdca;
    }

    .pill-autofix {
      background-color: var(--bg-autofix);
      color: var(--color-autofix);
      border: 1px solid #bfdbfe;
    }

    .pill-fixfailed {
      background-color: var(--bg-fixfailed);
      color: var(--color-fixfailed);
      border: 1px solid #fdba74;
    }

    .pill-info {
      background-color: var(--bg-info);
      color: var(--color-info);
      border: 1px solid var(--color-border);
    }

    .gate-badge {
      display: inline-block;
      padding: 2px 6px;
      font-size: 11px;
      font-weight: 600;
      border-radius: 4px;
      background-color: #f2f4f7;
      color: #344054;
      border: 1px solid var(--color-border);
    }

    .mono-cell {
      font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, Courier, monospace;
      font-size: 12px;
    }

    details {
      margin-bottom: 12px;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      background-color: #ffffff;
      overflow: hidden;
    }

    summary {
      padding: 10px 14px;
      font-weight: 600;
      font-size: 13px;
      color: #344054;
      background-color: #f9fafb;
      cursor: pointer;
      user-select: none;
      outline: none;
    }

    summary:hover {
      background-color: #f2f4f7;
    }

    .details-content {
      padding: 14px;
      border-top: 1px solid var(--color-border);
      background-color: #0f172a;
      color: #f8fafc;
      font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, Courier, monospace;
      font-size: 12px;
      line-height: 1.45;
      white-space: pre-wrap;
      word-break: break-all;
      overflow-x: auto;
    }

    .action-btn {
      display: inline-flex;
      align-items: center;
      padding: 6px 12px;
      font-size: 12px;
      font-weight: 600;
      border-radius: 4px;
      border: 1px solid var(--color-border);
      background-color: #ffffff;
      color: #344054;
      cursor: pointer;
      transition: background-color 0.15s ease;
    }

    .action-btn:hover {
      background-color: #f9fafb;
      border-color: #d0d5dd;
    }

    .footer-band {
      padding: 20px 32px;
      background-color: #f9fafb;
      border-top: 1px solid var(--color-border);
      font-size: 12px;
      color: #667085;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }

    @media print {
      body {
        background-color: #ffffff;
        padding: 0;
      }
      .report-container {
        border: none;
        box-shadow: none;
        max-width: 100%;
      }
      .no-print {
        display: none !important;
      }
      details {
        border: 1px solid #e4e7ec !important;
        margin-bottom: 16px !important;
        page-break-inside: avoid;
      }
      details[open], details {
        display: block !important;
      }
      summary {
        display: block !important;
        font-weight: bold;
        background-color: #f2f4f7 !important;
        color: #000000 !important;
      }
      .details-content {
        display: block !important;
        background-color: #f8f9fb !important;
        color: #101828 !important;
        border-top: 1px solid #e4e7ec !important;
      }
    }
  </style>
</head>
<body>
  <div class="report-container">
    
    <!-- Header Band -->
    <header class="header-band">
      <div class="header-info">
        <h1>{{ report_title | default('ARO Cluster Health Overview') }}</h1>
        <div class="header-meta">
          <span class="header-meta-item">Cluster: <strong>{{ cluster_name | default('N/A') }}</strong></span>
          {% if cluster_tier | default('') | length > 0 %}
          <span class="header-meta-item">Tier: <strong>{{ cluster_tier }}</strong></span>
          {% endif %}
          <span class="header-meta-item">Upgrade Target: <strong>{{ target_cluster_version | default(upgrade_path | default([]) | join(' &rarr; ') | default('N/A')) }}</strong></span>
          <span class="header-meta-item">Timestamp: <strong>{{ report_timestamp | default((ansible_date_time.iso8601 if (ansible_date_time is defined and ansible_date_time.iso8601 is defined) else 'N/A')) }}</strong></span>
        </div>
      </div>
      <div>
        {% set v = overall_verdict | default('PASS') | upper %}
        {% if 'AUTO' in v %}
        <span class="verdict-badge verdict-autofix">{{ badge_autofix | default('AUTO-FIXED ⚙') }}</span>
        {% elif 'WARN' in v %}
        <span class="verdict-badge verdict-warn">{{ badge_warn | default('WARN !') }}</span>
        {% elif 'FAIL' in v or 'HALT' in v %}
        <span class="verdict-badge verdict-fail">{{ badge_fail | default('FAIL ✖') }}</span>
        {% elif 'FIX-FAILED' in v %}
        <span class="verdict-badge verdict-fixfailed">{{ badge_fixfailed | default('FIX-FAILED ⚠') }}</span>
        {% else %}
        <span class="verdict-badge verdict-pass">{{ badge_pass | default('PASS ✔') }}</span>
        {% endif %}
      </div>
    </header>

    <!-- Summary Metrics -->
    <section class="metrics-section">
      <div class="metric-tiles">
        <div class="metric-tile">
          <div class="label">Total Checks</div>
          <div class="count" style="color: var(--color-heading);">{{ total_checks | default(checks | default([]) | length) }}</div>
        </div>
        <div class="metric-tile">
          <div class="label">Passed</div>
          <div class="count" style="color: var(--color-pass);">{{ passed_count | default(0) }}</div>
        </div>
        <div class="metric-tile">
          <div class="label">Warnings</div>
          <div class="count" style="color: var(--color-warn);">{{ warning_count | default(0) }}</div>
        </div>
        <div class="metric-tile">
          <div class="label">Auto-Fixed</div>
          <div class="count" style="color: var(--color-autofix);">{{ autofixed_count | default(0) }}</div>
        </div>
        <div class="metric-tile">
          <div class="label">Failed</div>
          <div class="count" style="color: var(--color-fail);">{{ failed_count | default(0) }}</div>
        </div>
      </div>
    </section>

    <!-- Content Body -->
    <main class="content-body">

      <!-- Auto-Remediation Callout (Conditional) -->
      {% if (autofix_items | default([]) | length > 0) or ((autofixed_count | default(0) | int) > 0) %}
      <div class="callout-box callout-autofix">
        <div style="font-weight: 700; margin-bottom: 6px; font-size: 14px;">
          ⚙ Automated Remediation Applied
        </div>
        <div>
          One or more known upgrade blockers were automatically remediated and verified according to Red Hat OpenShift upgrade policy:
          <ul style="margin: 6px 0 0 18px; padding: 0;">
            {% for fix in autofix_items | default([]) %}
            <li style="margin-bottom: 4px;">
              <strong>{{ fix.name | default('Remediation') }}:</strong> {{ fix.action | default('Applied automated patch and verified condition.') }}
              {% if fix.reference | default('') | length > 0 %}
              &bull; <a href="{{ fix.reference }}" target="_blank" style="color: #1d4ed8; text-decoration: underline;">Reference Documentation</a>
              {% endif %}
            </li>
            {% else %}
            <li>Automated remediation was executed and the safety re-check completed successfully.</li>
            {% endfor %}
          </ul>
        </div>
      </div>
      {% endif %}

      <!-- Primary Health Checks Table -->
      <div class="section-title">
        <span>Health Validation Results</span>
        <button type="button" class="action-btn no-print" onclick="copyTableText()" id="copy-btn">
          📋 Copy Summary
        </button>
      </div>

      <table class="status-table" id="status-table">
        <thead>
          <tr>
            <th style="width: 5%; text-align: center;">#</th>
            <th style="width: 25%;">Check Name</th>
            <th style="width: 42%;">Observed State / Details</th>
            <th style="width: 13%; text-align: center;">Gate Type</th>
            <th style="width: 15%; text-align: right;">Verdict</th>
          </tr>
        </thead>
        <tbody>
          {% for check in checks | default([]) %}
          {% set cstatus = check.status | default('PASS') | upper %}
          <tr class="{% if 'AUTO' in cstatus %}row-autofix{% elif 'WARN' in cstatus %}row-warn{% elif 'FAIL' in cstatus %}row-fail{% elif 'FIX-FAILED' in cstatus %}row-fixfailed{% else %}row-pass{% endif %}">
            <td style="text-align: center; font-weight: 600; color: #667085;">{{ check.num | default(loop.index) }}</td>
            <td style="font-weight: 600; color: #101828;">{{ check.name | default('Health Check') }}</td>
            <td class="mono-cell" style="color: #344054;">{{ check.observed | default('Healthy / passed validation') }}</td>
            <td style="text-align: center;">
              <span class="gate-badge">{{ check.gate | default('HARD') }}</span>
            </td>
            <td style="text-align: right;">
              {% if 'AUTO' in cstatus %}
              <span class="status-pill pill-autofix">{{ badge_autofix | default('AUTO-FIXED ⚙') }}</span>
              {% elif 'WARN' in cstatus %}
              <span class="status-pill pill-warn">{{ badge_warn | default('WARN !') }}</span>
              {% elif 'FIX-FAILED' in cstatus %}
              <span class="status-pill pill-fixfailed">{{ badge_fixfailed | default('FIX-FAILED ⚠') }}</span>
              {% elif 'FAIL' in cstatus %}
              <span class="status-pill pill-fail">{{ badge_fail | default('FAIL ✖') }}</span>
              {% else %}
              <span class="status-pill pill-pass">{{ badge_pass | default('PASS ✔') }}</span>
              {% endif %}
            </td>
          </tr>
          {% else %}
          <tr>
            <td colspan="5" style="text-align: center; padding: 16px; color: #667085;">
              No health check records provided.
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>

      <!-- Operator Validation Specific Section (Phase 06) -->
      {% if (is_operator_report | default(false) in [true, 'True', 'true', 1, '1']) or (operators | default([]) | length > 0) %}
      <div class="section-title">
        <span>OLM Operator Compatibility &amp; CSV Lifecycle</span>
      </div>
      <table class="status-table">
        <thead>
          <tr>
            <th style="width: 25%;">Subscription &bull; Namespace</th>
            <th style="width: 20%;">Installed CSV</th>
            <th style="width: 18%;">Target Channel</th>
            <th style="width: 20%;">InstallPlan Approval</th>
            <th style="width: 17%; text-align: right;">CSV Phase</th>
          </tr>
        </thead>
        <tbody>
          {% for op in operators | default([]) %}
          {% set opstatus = op.status | default('PASS') | upper %}
          <tr class="{% if 'FAIL' in opstatus %}row-fail{% elif 'WARN' in opstatus %}row-warn{% else %}row-pass{% endif %}">
            <td>
              <strong style="color: #101828;">{{ op.subscription | default('operator') }}</strong>
              <div style="font-size: 11px; color: #667085;">{{ op.namespace | default('openshift-operators') }}</div>
            </td>
            <td class="mono-cell">{{ op.installed_csv | default('N/A') }}</td>
            <td class="mono-cell">{{ op.target_channel | default('stable') }}</td>
            <td>
              <span class="gate-badge">{{ op.installplan_approval | default('Automatic') }}</span>
            </td>
            <td style="text-align: right;">
              {% if op.csv_phase | default('Succeeded') == 'Succeeded' %}
              <span class="status-pill pill-pass">Succeeded ✔</span>
              {% elif op.csv_phase | default('') == 'Pending' %}
              <span class="status-pill pill-warn">Pending !</span>
              {% else %}
              <span class="status-pill pill-fail">{{ op.csv_phase | default('Failed') }} ✖</span>
              {% endif %}
            </td>
          </tr>
          {% else %}
          <tr>
            <td colspan="5" style="text-align: center; padding: 16px; color: #667085;">
              No OLM operators discovered or validated.
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}

      <!-- Collapsible Deep Diagnostic Details (<details>) -->
      {% if diagnostic_details | default([]) | length > 0 %}
      <div class="section-title">
        <span>Deep Diagnostics &amp; Raw Inspection Data</span>
      </div>
      {% for item in diagnostic_details %}
      <details>
        <summary>{{ item.title | default('Diagnostic Output') }}</summary>
        <div class="details-content">{{ item.content | default('No raw output captured.') }}</div>
      </details>
      {% endfor %}
      {% endif %}

    </main>

    <!-- Footer Band -->
    <footer class="footer-band">
      <div>
        <strong>Execution Host:</strong> {{ ansible_hostname | default('localhost') }} &bull;
        <strong>Ansible:</strong> {{ (ansible_version.string if (ansible_version is defined and ansible_version.string is defined) else '2.x') }} &bull;
        <strong>Log File:</strong> <code>{{ log_file_path | default('playbooks/logs/' ~ (cluster_name | default('cluster')) ~ '.txt') }}</code>
      </div>
      <div>
        ARO Upgrade Engine &bull; Generated {{ report_timestamp | default((ansible_date_time.iso8601 if (ansible_date_time is defined and ansible_date_time.iso8601 is defined) else 'N/A')) }}
      </div>
    </footer>

  </div>

  <script class="no-print">
    function copyTableText() {
      const table = document.getElementById('status-table');
      if (!table) return;
      let text = "ARO Upgrade Health Check Summary - {{ cluster_name | default('Cluster') }}\n";
      text += "Overall Verdict: {{ overall_verdict | default('PASS') }}\n";
      text += "Generated: {{ report_timestamp | default('N/A') }}\n\n";
      const rows = table.querySelectorAll('tbody tr');
      rows.forEach(row => {
        const cells = row.querySelectorAll('td');
        if (cells.length >= 5) {
          const num = cells[0].innerText.trim();
          const name = cells[1].innerText.trim();
          const observed = cells[2].innerText.trim();
          const gate = cells[3].innerText.trim();
          const verdict = cells[4].innerText.trim();
          text += `[${verdict}] #${num} ${name} (${gate}) -> ${observed}\n`;
        }
      });
      navigator.clipboard.writeText(text).then(() => {
        const btn = document.getElementById('copy-btn');
        if (btn) {
          btn.innerText = '✔ Copied!';
          setTimeout(() => { btn.innerText = '📋 Copy Summary'; }, 2000);
        }
      }).catch(err => {
        console.error('Clipboard copy failed: ', err);
      });
    }
  </script>
</body>
</html>
