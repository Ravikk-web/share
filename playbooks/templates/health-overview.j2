{#- Targets Ansible 2.7.17.
    MIGRATION 2.14: No changes required — Jinja2 template is compatible with both versions.
    
    health-overview.j2 — Client-Facing HTML Report Template
    Presentation-only: Renders modern, colour-coded HTML reports for Pre-Upgrade Validation
    and Post-Upgrade Verification phases.
    All status colours and verdicts are driven by passed-in variables per ui-context.md.
-#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ report_title | default('ARO Cluster Upgrade Report') }} — {{ cluster_name | default('Cluster') }} ({{ phase_name | default(report_phase | default('Validation')) }})</title>
  <style>
    :root {
      --green-text: #1a7f37;
      --green-bg: #e6f4ea;
      --green-border: #b7eb8f;
      --amber-text: #9a6700;
      --amber-bg: #fff8e1;
      --amber-border: #ffe58f;
      --red-text: #b42318;
      --red-bg: #fdecea;
      --red-border: #ffa39e;
      --neutral-text: #344054;
      --neutral-bg: #f2f4f7;
      --neutral-border: #d0d5dd;
      --surface: #ffffff;
      --page-bg: #f8f9fb;
      --border: #e4e7ec;
      --heading: #101828;
      --muted: #667085;
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --font-mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, Courier, monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-sans);
      font-size: 14px;
      line-height: 1.5;
      color: var(--neutral-text);
      background-color: var(--page-bg);
      padding: 24px 16px;
      -webkit-font-smoothing: antialiased;
    }

    .report-container {
      max-width: 1040px;
      margin: 0 auto;
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      box-shadow: 0 2px 6px rgba(16, 24, 40, 0.04);
      overflow: hidden;
    }

    /* Header Band */
    .header-band {
      padding: 24px 32px;
      background-color: #ffffff;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
    }

    .header-left {
      flex: 1;
    }

    .org-banner {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .report-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--heading);
      line-height: 1.3;
      margin-bottom: 8px;
    }

    .cluster-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: var(--neutral-text);
      background-color: var(--neutral-bg);
      border: 1px solid var(--border);
      padding: 3px 10px;
      border-radius: 6px;
    }

    .cluster-name {
      font-family: var(--font-mono);
      font-weight: 600;
      color: var(--heading);
    }

    .header-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 10px;
    }

    /* Verdict Pills */
    .verdict-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 18px;
      font-size: 14px;
      font-weight: 700;
      border-radius: 24px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }

    .verdict-pill.pass {
      color: var(--green-text);
      background-color: var(--green-bg);
      border: 1px solid var(--green-border);
    }

    .verdict-pill.warn {
      color: var(--amber-text);
      background-color: var(--amber-bg);
      border: 1px solid var(--amber-border);
    }

    .verdict-pill.fail {
      color: var(--red-text);
      background-color: var(--red-bg);
      border: 1px solid var(--red-border);
    }

    /* Metadata Strip */
    .metadata-strip {
      background-color: #fafbfc;
      border-bottom: 1px solid var(--border);
      padding: 12px 32px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      font-size: 12px;
      color: var(--muted);
    }

    .meta-group {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }

    .meta-item strong {
      color: var(--heading);
      font-weight: 600;
    }

    .meta-item code {
      font-family: var(--font-mono);
      color: var(--heading);
    }

    /* Action Toolbar / Copy Button */
    .toolbar-actions {
      display: flex;
      gap: 8px;
    }

    .btn-action {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background-color: var(--surface);
      color: var(--neutral-text);
      border: 1px solid var(--border);
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease-in-out;
      user-select: none;
    }

    .btn-action:hover {
      background-color: #f2f4f7;
      color: var(--heading);
      border-color: #d0d5dd;
    }

    .btn-action:active {
      transform: translateY(1px);
    }

    .btn-action.copied {
      background-color: var(--green-bg);
      color: var(--green-text);
      border-color: var(--green-border);
    }

    /* Content Area */
    .report-body {
      padding: 28px 32px;
    }

    .section-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--heading);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Summary Tiles Grid */
    .tiles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 16px;
      margin-bottom: 28px;
    }

    .tile-card {
      background-color: #ffffff;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.1s ease;
    }

    .tile-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
    }

    .tile-value {
      font-size: 26px;
      font-weight: 700;
      color: var(--heading);
      line-height: 1.1;
      display: flex;
      align-items: baseline;
      gap: 6px;
    }

    .tile-card.pass {
      border-left: 4px solid var(--green-text);
    }
    .tile-card.pass .tile-value {
      color: var(--green-text);
    }

    .tile-card.warn {
      border-left: 4px solid var(--amber-text);
    }
    .tile-card.warn .tile-value {
      color: var(--amber-text);
    }

    .tile-card.fail {
      border-left: 4px solid var(--red-text);
    }
    .tile-card.fail .tile-value {
      color: var(--red-text);
    }

    .tile-card.neutral {
      border-left: 4px solid #667085;
    }

    .tile-subtext {
      font-size: 11px;
      color: var(--muted);
      margin-top: 6px;
    }

    /* Status Table */
    .table-container {
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      margin-bottom: 28px;
      background-color: var(--surface);
    }

    table.status-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 13px;
    }

    table.status-table th {
      background-color: #f8f9fb;
      color: #344054;
      font-weight: 600;
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    table.status-table td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }

    table.status-table tr:last-child td {
      border-bottom: none;
    }

    /* Row highlight classes */
    tr.row-pass {
      background-color: #ffffff;
    }
    tr.row-warn {
      background-color: #fffdf5;
    }
    tr.row-fail {
      background-color: #fff8f8;
    }

    .gate-badge {
      display: inline-block;
      padding: 2px 7px;
      font-size: 10px;
      font-weight: 700;
      border-radius: 4px;
      letter-spacing: 0.4px;
      text-transform: uppercase;
    }

    .gate-badge.hard {
      color: #b42318;
      background-color: #fdecea;
      border: 1px solid #ffa39e;
    }

    .gate-badge.warn {
      color: #9a6700;
      background-color: #fff8e1;
      border: 1px solid #ffe58f;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 8px;
      font-size: 11px;
      font-weight: 700;
      border-radius: 12px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      white-space: nowrap;
    }

    .status-badge.pass {
      color: var(--green-text);
      background-color: var(--green-bg);
      border: 1px solid var(--green-border);
    }

    .status-badge.warn {
      color: var(--amber-text);
      background-color: var(--amber-bg);
      border: 1px solid var(--amber-border);
    }

    .status-badge.fail {
      color: var(--red-text);
      background-color: var(--red-bg);
      border: 1px solid var(--red-border);
    }

    .check-id {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--muted);
      font-weight: 600;
    }

    .check-name {
      font-weight: 600;
      color: var(--heading);
      margin-bottom: 3px;
    }

    .check-details {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.4;
    }

    .check-observed {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--neutral-text);
      word-break: break-word;
    }

    /* Collapsible Details Section */
    .collapsible-wrapper {
      margin-bottom: 28px;
    }

    details.detail-card {
      background-color: #fafbfc;
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 12px;
      overflow: hidden;
    }

    details.detail-card summary {
      padding: 12px 16px;
      font-weight: 600;
      font-size: 13px;
      color: var(--heading);
      cursor: pointer;
      user-select: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: #f8f9fb;
      border-bottom: 1px solid transparent;
      outline: none;
    }

    details.detail-card[open] summary {
      border-bottom-color: var(--border);
      background-color: #f2f4f7;
    }

    details.detail-card summary:hover {
      background-color: #edf0f4;
    }

    .detail-content {
      padding: 16px;
      background-color: #ffffff;
    }

    pre.raw-output {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.45;
      background-color: #f8f9fb;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 12px 14px;
      overflow-x: auto;
      white-space: pre-wrap;
      word-break: break-all;
      color: var(--neutral-text);
    }

    /* Footer Band */
    .footer-band {
      background-color: #fafbfc;
      border-top: 1px solid var(--border);
      padding: 18px 32px;
      text-align: center;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.6;
    }

    .footer-title {
      font-weight: 600;
      color: var(--heading);
      margin-bottom: 4px;
    }

    .footer-paths code {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--neutral-text);
      background-color: #f2f4f7;
      padding: 2px 6px;
      border-radius: 4px;
    }

    /* Responsive styling */
    @media (max-width: 768px) {
      .header-band {
        flex-direction: column;
        align-items: stretch;
      }
      .header-right {
        align-items: flex-start;
      }
      .metadata-strip {
        flex-direction: column;
        align-items: flex-start;
      }
      .report-body {
        padding: 20px 16px;
      }
    }

    /* Print and PDF Hand-off rules */
    @media print {
      body {
        background-color: #ffffff !important;
        padding: 0 !important;
        font-size: 12px !important;
      }
      .report-container {
        border: none !important;
        box-shadow: none !important;
        max-width: 100% !important;
      }
      .no-print {
        display: none !important;
      }
      details.detail-card {
        display: block !important;
        border: 1px solid #ccc !important;
        page-break-inside: avoid;
        margin-bottom: 12px !important;
      }
      details.detail-card summary {
        display: block !important;
        font-weight: bold;
        background-color: #eee !important;
      }
      .detail-content {
        display: block !important;
      }
      .table-container {
        page-break-inside: auto;
      }
      tr {
        page-break-inside: avoid;
      }
      /* Grayscale-safe borders and indicators */
      .verdict-pill, .status-badge, .gate-badge {
        border-width: 1px !important;
      }
    }
  </style>
</head>
<body>

  <div class="report-container">

    <!-- 1. Header Band -->
    <header class="header-band">
      <div class="header-left">
        <div class="org-banner">
          {{ report_org | default('Cloud Platform Engineering') }} &bull; Operational Report
        </div>
        <h1 class="report-title">
          {{ report_title | default('ARO Cluster Upgrade Report') }}
        </h1>
        <div class="cluster-badge">
          <span>Cluster:</span>
          <span class="cluster-name">{{ cluster_name | default('N/A') }}</span>
        </div>
      </div>

      <div class="header-right">
        <!-- Overall Verdict Pill -->
        {% set effective_verdict = (report_verdict | default('')) | upper %}
        {% if effective_verdict == '' %}
          {% if (failed_validations | default([]) | length > 0) or (health_summary | default([]) | selectattr('status', 'equalto', 'FAIL') | list | length > 0) %}
            {% set effective_verdict = 'FAIL' %}
          {% elif (health_summary | default([]) | selectattr('status', 'equalto', 'WARN') | list | length > 0) %}
            {% set effective_verdict = 'WARN' %}
          {% else %}
            {% set effective_verdict = 'PASS' %}
          {% endif %}
        {% endif %}

        {% if effective_verdict == 'PASS' %}
          <div class="verdict-pill pass">
            <span>{{ (status_glyphs | default({})).pass | default('✔') }}</span>
            <span>VERDICT: PASS</span>
          </div>
        {% elif effective_verdict == 'WARN' %}
          <div class="verdict-pill warn">
            <span>{{ (status_glyphs | default({})).warn | default('!') }}</span>
            <span>VERDICT: WARN</span>
          </div>
        {% else %}
          <div class="verdict-pill fail">
            <span>{{ (status_glyphs | default({})).fail | default('✖') }}</span>
            <span>VERDICT: FAIL</span>
          </div>
        {% endif %}

        <div class="toolbar-actions no-print">
          <button id="copyDiagnosticsBtn" class="btn-action" onclick="copyReportDiagnostics()" title="Copy diagnostic identifiers and failure summary to clipboard">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copyBtnLabel">Copy Diagnostics</span>
          </button>
        </div>
      </div>
    </header>

    <!-- 2. Metadata Strip -->
    <div class="metadata-strip">
      <div class="meta-group">
        <div class="meta-item">
          <strong>Phase:</strong> {{ phase_name | default(report_phase | default('Pre-Upgrade Validation')) }}
        </div>
        <div class="meta-item">
          <strong>Run ID:</strong> <code>{{ run_id | default(timestamp | default('N/A')) }}</code>
        </div>
        <div class="meta-item">
          <strong>Timestamp:</strong> {{ timestamp | default(ansible_date_time.iso8601 if (ansible_date_time is defined and ansible_date_time.iso8601 is defined) else 'N/A') }}
        </div>
        {% if target_version is defined and target_version | length > 0 %}
        <div class="meta-item">
          <strong>Target Version:</strong> <code>{{ target_version }}</code>
        </div>
        {% elif upgrade_path is defined and upgrade_path | length > 0 %}
        <div class="meta-item">
          <strong>Upgrade Path:</strong> <code>{{ upgrade_path | join(' &rarr; ') }}</code>
        </div>
        {% endif %}
      </div>
      <div class="meta-item">
        <strong>Execution Mode:</strong> {{ 'Dry Run (Validation Only)' if (dry_run | default(false)) else 'Active Run' }}
      </div>
    </div>

    <!-- 3. Report Body Content -->
    <main class="report-body">

      <!-- Summary Tiles Section -->
      <section>
        <div class="section-title">
          <span>Execution Summary</span>
        </div>

        {#- Compute Counts safely -#}
        {% set count_pass = (health_summary | default([]) | selectattr('status', 'equalto', 'PASS') | list | length) %}
        {% set count_warn = (health_summary | default([]) | selectattr('status', 'equalto', 'WARN') | list | length) %}
        {% set count_fail = (health_summary | default([]) | selectattr('status', 'equalto', 'FAIL') | list | length) + (failed_validations | default([]) | length) %}
        {% set count_total = (health_summary | default([]) | length) + (failed_validations | default([]) | length) %}

        {% if report_pass_count is defined %}{% set count_pass = report_pass_count %}{% endif %}
        {% if report_warn_count is defined %}{% set count_warn = report_warn_count %}{% endif %}
        {% if report_fail_count is defined %}{% set count_fail = report_fail_count %}{% endif %}
        {% if report_total_count is defined %}{% set count_total = report_total_count %}{% endif %}

        <div class="tiles-grid">
          <!-- Total Checks Tile -->
          <div class="tile-card neutral">
            <div class="tile-label">Total Checks Evaluated</div>
            <div class="tile-value">{{ count_total }}</div>
            <div class="tile-subtext">Across all pre/post validation rules</div>
          </div>

          <!-- Passed Tile -->
          <div class="tile-card pass">
            <div class="tile-label">Passed Checks</div>
            <div class="tile-value">
              <span>{{ count_pass }}</span>
              <span style="font-size: 16px;">{{ (status_glyphs | default({})).pass | default('✔') }}</span>
            </div>
            <div class="tile-subtext">Hard and warn criteria satisfied</div>
          </div>

          <!-- Warnings Tile -->
          <div class="tile-card warn">
            <div class="tile-label">Non-Blocking Warnings</div>
            <div class="tile-value">
              <span>{{ count_warn }}</span>
              <span style="font-size: 16px;">{{ (status_glyphs | default({})).warn | default('!') }}</span>
            </div>
            <div class="tile-subtext">Requires review; upgrade allowed</div>
          </div>

          <!-- Failed Tile -->
          <div class="tile-card fail">
            <div class="tile-label">Hard Gate Failures</div>
            <div class="tile-value">
              <span>{{ count_fail }}</span>
              <span style="font-size: 16px;">{{ (status_glyphs | default({})).fail | default('✖') }}</span>
            </div>
            <div class="tile-subtext">Blocks upgrade execution</div>
          </div>
        </div>
      </section>

      <!-- Detailed Status Table Section -->
      <section>
        <div class="section-title">
          <span>Validation Checks Status</span>
        </div>

        <div class="table-container">
          <table class="status-table">
            <thead>
              <tr>
                <th style="width: 48px; text-align: center;">#</th>
                <th style="width: 240px;">Check Name</th>
                <th style="width: 75px; text-align: center;">Gate</th>
                <th>Observed Cluster State &amp; Details</th>
                <th style="width: 105px; text-align: center;">Status</th>
              </tr>
            </thead>
            <tbody>
              {% if (health_summary is defined and health_summary | length > 0) or (failed_validations is defined and failed_validations | length > 0) %}
                
                {# Render health_summary entries #}
                {% for item in (health_summary | default([])) %}
                  {% set item_status = (item.status | default('PASS')) | upper %}
                  {% set row_class = item.row_class | default('row-pass' if item_status == 'PASS' else ('row-warn' if item_status == 'WARN' else 'row-fail')) %}
                  <tr class="{{ row_class }}">
                    <td style="text-align: center;">
                      <span class="check-id">{{ item.id | default(loop.index) }}</span>
                    </td>
                    <td>
                      <div class="check-name">{{ item.name | default(item.check_name | default('Validation Check')) }}</div>
                      {% if item.details is defined and item.details | length > 0 %}
                        <div class="check-details">{{ item.details }}</div>
                      {% endif %}
                    </td>
                    <td style="text-align: center;">
                      {% set gate_type = (item.gate | default(item.gate_type | default('HARD'))) | upper %}
                      <span class="gate-badge {{ 'hard' if gate_type == 'HARD' else 'warn' }}">
                        {{ gate_type }}
                      </span>
                    </td>
                    <td>
                      <div class="check-observed">
                        {{ item.observed | default(item.observed_value | default('Healthy condition verified')) }}
                      </div>
                      {% if item.reason is defined and item.reason | length > 0 %}
                        <div style="margin-top: 4px; color: var(--red-text); font-size: 12px; font-weight: 500;">
                          Reason: {{ item.reason }}
                        </div>
                      {% endif %}
                    </td>
                    <td style="text-align: center;">
                      {% if item_status == 'PASS' %}
                        <span class="status-badge pass">
                          {{ (status_glyphs | default({})).pass | default('✔') }} PASS
                        </span>
                      {% elif item_status == 'WARN' %}
                        <span class="status-badge warn">
                          {{ (status_glyphs | default({})).warn | default('!') }} WARN
                        </span>
                      {% else %}
                        <span class="status-badge fail">
                          {{ (status_glyphs | default({})).fail | default('✖') }} FAIL
                        </span>
                      {% endif %}
                    </td>
                  </tr>
                {% endfor %}

                {# Render any explicit failed_validations if not already present in health_summary #}
                {% for fail_item in (failed_validations | default([])) %}
                  {% if fail_item.name not in (health_summary | default([]) | map(attribute='name') | list) %}
                  <tr class="row-fail">
                    <td style="text-align: center;">
                      <span class="check-id">{{ fail_item.id | default(fail_item.step | default('F')) }}</span>
                    </td>
                    <td>
                      <div class="check-name">{{ fail_item.name | default(fail_item.task | default(fail_item.check_name | default('Critical Failure'))) }}</div>
                      {% if fail_item.reason is defined and fail_item.reason | length > 0 %}
                        <div class="check-details" style="color: var(--red-text);">{{ fail_item.reason }}</div>
                      {% endif %}
                    </td>
                    <td style="text-align: center;">
                      <span class="gate-badge hard">HARD</span>
                    </td>
                    <td>
                      <div class="check-observed">
                        {{ fail_item.observed_value | default(fail_item.observed | default('Failure condition observed')) }}
                      </div>
                    </td>
                    <td style="text-align: center;">
                      <span class="status-badge fail">
                        {{ (status_glyphs | default({})).fail | default('✖') }} FAIL
                      </span>
                    </td>
                  </tr>
                  {% endif %}
                {% endfor %}

              {% else %}
                <tr>
                  <td colspan="5" style="text-align: center; padding: 24px; color: var(--muted);">
                    No check results available in health_summary.
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </section>

      <!-- 4. Collapsible Raw Details Section -->
      <section class="collapsible-wrapper">
        <div class="section-title">
          <span>Diagnostic Evidence &amp; Raw Output</span>
        </div>

        {#- Render check details -#}
        {% for item in (health_summary | default([])) %}
          {% if (item.raw_output is defined and item.raw_output | length > 0) or (item.status | default('') != 'PASS') %}
            <details class="detail-card">
              <summary>
                <span>Check {{ item.id | default(loop.index) }}: {{ item.name | default('Check') }} [{{ item.status | default('PASS') }}]</span>
                <span style="font-size: 11px; color: var(--muted);">Click to expand</span>
              </summary>
              <div class="detail-content">
                <div style="margin-bottom: 8px; font-size: 12px;">
                  <strong>Observed Summary:</strong> {{ item.observed | default(item.observed_value | default('N/A')) }}
                </div>
                {% if item.details is defined and item.details | length > 0 %}
                <div style="margin-bottom: 8px; font-size: 12px;">
                  <strong>Verification Details:</strong> {{ item.details }}
                </div>
                {% endif %}
                {% if item.raw_output is defined and item.raw_output | length > 0 %}
                <div style="margin-bottom: 4px; font-size: 11px; font-weight: 600; color: var(--muted); text-transform: uppercase;">Raw oc / jq Inspection Payload:</div>
                <pre class="raw-output">{{ item.raw_output }}</pre>
                {% endif %}
              </div>
            </details>
          {% endif %}
        {% endfor %}

        {#- Render failure details -#}
        {% for fail_item in (failed_validations | default([])) %}
          <details class="detail-card">
            <summary style="color: var(--red-text);">
              <span>Failure Detail: {{ fail_item.name | default(fail_item.task | default('Failure')) }} [FAIL]</span>
              <span style="font-size: 11px; color: var(--muted);">Click to expand</span>
            </summary>
            <div class="detail-content">
              <div style="margin-bottom: 8px; font-size: 12px;">
                <strong>Gate:</strong> {{ fail_item.gate_type | default('HARD') }} &bull; <strong>Step:</strong> {{ fail_item.step | default(fail_item.id | default('N/A')) }}
              </div>
              <div style="margin-bottom: 8px; font-size: 12px;">
                <strong>Observed:</strong> {{ fail_item.observed_value | default(fail_item.observed | default('N/A')) }}
              </div>
              <div style="margin-bottom: 8px; font-size: 12px; color: var(--red-text);">
                <strong>Failure Reason:</strong> {{ fail_item.reason | default(fail_item.error_output | default('N/A')) }}
              </div>
              {% if fail_item.error_output is defined and fail_item.error_output | length > 0 %}
              <div style="margin-bottom: 4px; font-size: 11px; font-weight: 600; color: var(--muted); text-transform: uppercase;">Error Output:</div>
              <pre class="raw-output">{{ fail_item.error_output }}</pre>
              {% endif %}
            </div>
          </details>
        {% endfor %}

        {#- Fallback when no warnings, failures, or raw outputs exist -#}
        {% set non_pass_count = (health_summary | default([]) | selectattr('status', 'equalto', 'WARN') | list | length) + (health_summary | default([]) | selectattr('status', 'equalto', 'FAIL') | list | length) + (failed_validations | default([]) | length) %}
        {% set raw_output_count = (health_summary | default([]) | selectattr('raw_output', 'defined') | list | length) %}
        {% if non_pass_count == 0 and raw_output_count == 0 %}
        <div style="background-color: #f8f9fb; border: 1px solid var(--border); border-radius: 6px; padding: 14px; text-align: center; color: var(--muted); font-size: 13px;">
          All validation checks passed with zero degraded conditions. No warning or failure diagnostics recorded.
        </div>
        {% endif %}
      </section>

    </main>

    <!-- 5. Footer Band -->
    <footer class="footer-band">
      <div class="footer-title">
        {{ report_footer | default('Generated by ARO Cluster Upgrade Automation') }}
      </div>
      <div class="footer-paths">
        Report File: <code>{{ output_file_name | default('output/' ~ cluster_name | default('cluster') ~ '_' ~ report_phase | default('validation') ~ '_' ~ timestamp | default('run') ~ '.html') }}</code> &bull;
        Run Log: <code>{{ log_path | default('logs/' ~ cluster_name | default('cluster') ~ '_' ~ timestamp | default('run') ~ '.txt') }}</code>
      </div>
      <div style="margin-top: 6px; font-size: 11px;">
        Azure Red Hat OpenShift &bull; Cloud Platform Engineering &bull; Hand-off Safe &amp; Print Optimized
      </div>
    </footer>

  </div>

  <!-- Client-side JavaScript for Copy Diagnostics (HTML report only) -->
  <script class="no-print">
    function copyReportDiagnostics() {
      const clusterName = "{{ cluster_name | default('UNKNOWN') }}";
      const phase = "{{ phase_name | default(report_phase | default('Validation')) }}";
      const runId = "{{ run_id | default(timestamp | default('N/A')) }}";
      const timestamp = "{{ timestamp | default('N/A') }}";
      const verdict = "{{ effective_verdict }}";
      const totalChecks = {{ count_total }};
      const passChecks = {{ count_pass }};
      const warnChecks = {{ count_warn }};
      const failChecks = {{ count_fail }};

      let text = "====================================================\n";
      text += "ARO CLUSTER UPGRADE REPORT DIAGNOSTICS\n";
      text += "====================================================\n";
      text += "Cluster:        " + clusterName + "\n";
      text += "Phase:          " + phase + "\n";
      text += "Run ID:         " + runId + "\n";
      text += "Timestamp:      " + timestamp + "\n";
      text += "Verdict:        " + verdict + "\n";
      text += "Summary:        " + passChecks + " passed / " + warnChecks + " warn / " + failChecks + " fail (Total: " + totalChecks + ")\n";
      text += "----------------------------------------------------\n";

      {% set fail_list = (failed_validations | default([])) + (health_summary | default([]) | selectattr('status', 'equalto', 'FAIL') | list) %}
      {% if fail_list | length > 0 %}
      text += "FAILURES:\n";
      {% for f in fail_list %}
      text += " - [Check {{ f.id | default(f.step | default('N/A')) }}] {{ f.name | default(f.task | default('Failure')) }}: {{ f.reason | default(f.observed | default('Critical error')) }}\n";
      {% endfor %}
      {% endif %}

      {% set warn_list = (health_summary | default([]) | selectattr('status', 'equalto', 'WARN') | list) %}
      {% if warn_list | length > 0 %}
      text += "WARNINGS:\n";
      {% for w in warn_list %}
      text += " - [Check {{ w.id | default('N/A') }}] {{ w.name | default('Warning') }}: {{ w.observed | default('Warning observed') }}\n";
      {% endfor %}
      {% endif %}

      text += "====================================================\n";

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(function() {
          showCopySuccess();
        }).catch(function(err) {
          fallbackCopy(text);
        });
      } else {
        fallbackCopy(text);
      }
    }

    function fallbackCopy(text) {
      const textArea = document.createElement("textarea");
      textArea.value = text;
      textArea.style.position = "fixed";
      textArea.style.left = "-999999px";
      textArea.style.top = "-999999px";
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try {
        document.execCommand('copy');
        showCopySuccess();
      } catch (err) {
        console.error('Fallback copy failed', err);
      }
      document.body.removeChild(textArea);
    }

    function showCopySuccess() {
      const btn = document.getElementById("copyDiagnosticsBtn");
      const label = document.getElementById("copyBtnLabel");
      if (btn && label) {
        btn.classList.add("copied");
        label.textContent = "Copied!";
        setTimeout(function() {
          btn.classList.remove("copied");
          label.textContent = "Copy Diagnostics";
        }, 2500);
      }
    }
  </script>

</body>
</html>
